pipeline {

    // Configure AWS access on this agent with an IAM role or Jenkins credentials; never store keys in this file.
    agent any

    triggers {
        githubPush()
    }

    environment {
        DEPLOY_ENVIRONMENT = "staging"
    }

    stages {

        stage("Checkout") {
            steps {
                dir("app") {
                    deleteDir()
                    git branch: "master",
                        url: "https://github.com/abhatwar/nearBy-Backend.git"
                }
            }
        }

        stage("Install Dependencies") {
            steps {
                dir("app") {
                    sh "npm ci"
                }
            }
        }

        stage("Test") {
            steps {
                dir("app") {
                    sh "npm test --if-present"
                }
            }
        }

        stage("Build and Deploy") {
            steps {
                sh """
                    chmod +x deploy.sh
                    APP_DIR=app ./deploy.sh ${DEPLOY_ENVIRONMENT} deploy
                """
            }
        }
    }

    post {
        success {
            echo "Automatic deployment to ${DEPLOY_ENVIRONMENT} completed successfully."
        }

        failure {
            echo "Automatic deployment to ${DEPLOY_ENVIRONMENT} failed."
        }
    }
}