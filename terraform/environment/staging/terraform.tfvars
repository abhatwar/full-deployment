# AWS region
aws_region = "ap-south-1"

# Project name
project_name = "nearby"

# Environment
environment = "staging"

# VPC CIDR
vpc_cidr = "10.0.0.0/16"

# Availability Zones
availability_zones = [
  "ap-south-1a",
  "ap-south-1b"
]

# Public subnets
public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

# Private subnets
private_subnet_cidrs = [
  "10.0.11.0/24",
  "10.0.12.0/24"
]